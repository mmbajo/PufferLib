+
+bool timer_lockstep_engaged(void)
+{
+	return lockstep_engaged;
+}
+
+void timer_lockstep_set(t_tick tick)
+{
+	if( DIFF_TICK(tick, lockstep_now) > 0 )
+		lockstep_now = tick;
+}
