 /// platform-abstracted tick retrieval
-static t_tick tick(void)
+static t_tick tick_real(void)
 {
 #if defined(ENABLE_RDTSC)
 	// RDTSC: Returns the number of CPU cycles since reset. Unreliable if the CPU frequency is variable.
@@ -166,6 +166,34 @@ static t_tick tick(void)
 #endif
 }
 
+// Lockstep: the clock is frozen at lockstep_now once engaged.
+static bool lockstep_engaged = false;
+static t_tick lockstep_now = 0;
+
+static t_tick tick(void)
+{
+	return lockstep_engaged ? lockstep_now : tick_real();
+}
+
+void timer_lockstep_engage(void)
+{
+	if( !lockstep_engaged ){
+		lockstep_now = tick_real();
+		lockstep_engaged = true;
+	}
