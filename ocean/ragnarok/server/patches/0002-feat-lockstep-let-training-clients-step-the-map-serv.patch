@@ -0,0 +1,111 @@
+// Lockstep stepping for training bots. Local patch, not part of upstream rAthena.
+//
+// With `lockstep: yes` in the map config, the clock follows the wall clock until the first client
+// sends CZ_LOCKSTEP_READY (0x0cf0). From then on it stands still between steps. A session that has
+// sent READY once is a member. A step runs when every member has sent READY since the last step:
+// the server runs the next lockstep_step ms of game time one timer at a time, so each timer sees
+// its own due time, then sends every member ZC_LOCKSTEP_DONE (0x0cf1: steps so far, server tick),
+// after everything else the step produced. Between steps the server keeps handling sockets in real
+// time, so logins and the char-server link work while the clients think. A member that sends no
+// READY for lockstep_timeout seconds of wall-clock time stops being one, so a dead client cannot
+// freeze the world.
+
+#include "lockstep.hpp"
+
+#include <ctime>
+
+#include <common/showmsg.hpp>
+#include <common/socket.hpp>
+
+#include "clif.hpp"
+#include "map.hpp"
+#include "pc.hpp"
+
+bool lockstep_enabled = false;
+int32 lockstep_step_ms = 100;
+int32 lockstep_timeout = 30;
+bool lockstep_debug = false;
+
+static uint32 lockstep_steps = 0;
+
+void lockstep_ready( map_session_data& sd ){
+	if( !lockstep_enabled )
+		return;
+	if( !timer_lockstep_engaged() ){
+		timer_lockstep_engage();
+		ShowStatus( "Lockstep engaged by '%s': %d ms of game time per step.\n", sd.status.name, lockstep_step_ms );
+	}
+	sd.lockstep_member = true;
+	sd.lockstep_pending = true;
+
+	static int32 debug_readies = 0;
+	if( lockstep_debug && ++debug_readies <= 10 )
+		ShowDebug( "Lockstep: READY %d from '%s' (account %u, on a map: %s)\n", debug_readies, sd.status.name, sd.status.account_id, sd.prev != nullptr ? "yes" : "no" );
+}
+
+// True when there is at least one member and every member is ready. Drops members that timed out.
+static bool lockstep_all_ready(){
+	bool any = false, all = true;
+	time_t now = time( nullptr );
+	s_mapiterator* iter = mapit_getallusers();
+
+	for( map_session_data* sd = (map_session_data*)mapit_first( iter ); mapit_exists( iter ); sd = (map_session_data*)mapit_next( iter ) ){
+		if( !sd->lockstep_member )
+			continue;
+		if( !sd->lockstep_pending ){
+			if( now - sd->lockstep_since > lockstep_timeout ){
+				ShowWarning( "Lockstep: '%s' sent no READY for %d s; no longer waiting for it.\n", sd->status.name, lockstep_timeout );
+				sd->lockstep_member = false;
+				continue;
+			}
+			all = false;
+		}
+		any = true;
+	}
+	mapit_free( iter );
+
+	static int32 debug_calls = 0;
+	if( lockstep_debug && ++debug_calls % 2000 == 1 )
+		ShowDebug( "Lockstep: barrier check %d: members %s, all ready %s, steps run %u\n", debug_calls, any ? "yes" : "no", all ? "yes" : "no", lockstep_steps );
+
+	return any && all;
+}
+
+static void lockstep_run_step(){
+	t_tick target = gettick() + lockstep_step_ms;
+
+	for( t_tick due = timer_next_due(); due >= 0 && DIFF_TICK( due, target ) <= 0; due = timer_next_due() ){
+		timer_lockstep_set( due );
+		do_timer( gettick() );
+	}
+	timer_lockstep_set( target );
+	do_timer( target );
+	lockstep_steps++;
+	if( lockstep_debug && ( lockstep_steps <= 3 || lockstep_steps % 1000 == 0 ) )
+		ShowDebug( "Lockstep: step %u done at tick %" PRtf "\n", lockstep_steps, target );
+
+	time_t now = time( nullptr );
+	s_mapiterator* iter = mapit_getallusers();
+
+	for( map_session_data* sd = (map_session_data*)mapit_first( iter ); mapit_exists( iter ); sd = (map_session_data*)mapit_next( iter ) ){
+		if( !sd->lockstep_member )
+			continue;
+		sd->lockstep_pending = false;
+		sd->lockstep_since = now;
+		clif_lockstep_done( *sd, lockstep_steps, target );
+	}
+	mapit_free( iter );
+}
+
+void lockstep_handle_main( t_tick next ){
+	if( !timer_lockstep_engaged() ){
+		do_sockets( next );
+		return;
+	}
+	if( lockstep_all_ready() ){
+		lockstep_run_step();
+		do_sockets( 0 );
+	}else{
+		do_sockets( 5 );
+	}
+}
